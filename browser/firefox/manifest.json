{
  "manifest_version": 2,
  "name": "Ss Download Manager Integration",
  "version": "1.0.0",
  "description": "Send browser downloads and links to Ss Download Manager. Developed by HeshamZegoo.",
  "permissions": ["activeTab", "contextMenus", "nativeMessaging"],
  "background": {"scripts": ["background.js"]},
  "browser_action": {"default_title": "Ss Download Manager"},
  "browser_specific_settings": {
    "gecko": {"id": "ss-download-manager@heshamzegoo"}
  }
}
