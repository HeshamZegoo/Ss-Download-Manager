{
  "manifest_version": 3,
  "name": "Ss Download Manager Integration",
  "version": "1.0.2",
  "description": "Send browser downloads and links to Ss Download Manager. Developed by HeshamZegoo.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "action": {
    "default_title": "Ss Download Manager"
  },
  "minimum_chrome_version": "105",
  "key": ""
}
